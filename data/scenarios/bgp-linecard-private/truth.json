        "slack:1785852660.000100"
      ],
      "realCause": "Firmware 11.2 causes port flaps on LC-2 line cards until patch 11.2.1 is installed.",
      "expectedClaims": [
        {
          "type": "observation",
          "statement": "PE-05 BGP sessions to both upstreams flap and line card ports log link flaps after the 11.2 upgrade",
          "by": "person:directory:anssi-heikura"
        },
        {
          "type": "condition",
          "statement": "PE-05 has an LC-2 line card installed in 2020",
          "by": "person:directory:anssi-heikura"
        },
        {
          "type": "advice",
          "statement": "Install patch 11.2.1 which fixes port flaps on LC-2 under firmware 11.2 and needs no reload",
          "by": "person:directory:ville-laakso"
        },
        {
          "type": "action",
          "statement": "Pasi installed patch 11.2.1 on PE-05",
          "by": "person:directory:pasi-tuomi"
        },
        {
          "type": "outcome",
          "statement": "PE-05 sessions stayed up with no port flaps for two hours after the patch",
          "by": "person:directory:pasi-tuomi"
        }
      ],
