    {
      "key": "B",
      "title": "PE-09 flaps after 11.2 on LC-3; patch does not help, BFD interval workaround",
      "sourceIds": [
        "slack:1786438800.000300",
        "slack:1786440300.000400",
        "slack:1786441800.000500",
        "slack:1786443600.000600"
      ],
      "realCause": "On LC-3 the 11.2 BFD default is too aggressive; patch 11.2.1 does not address it, raising the BFD interval to 300 ms does (vendor advisory under NDA).",
      "expectedClaims": [
        {
          "type": "observation",
          "statement": "PE-09 with LC-3 flaps after the 11.2 upgrade",
          "by": "person:directory:ville-laakso"
        },
        {
          "type": "action",
          "statement": "Pasi installed patch 11.2.1 on PE-09 with no change",
          "by": "person:directory:pasi-tuomi"
        },
        {
          "type": "advice",
          "statement": "Set the BFD interval to 300 ms on the affected sessions as the vendor workaround for LC-3",
          "by": "person:directory:ville-laakso"
        },
        {
          "type": "action",
          "statement": "Pasi raised the BFD interval on PE-09",
          "by": "person:directory:pasi-tuomi"
        },
        {
          "type": "outcome",
          "statement": "PE-09 sessions are stable after the BFD interval change",
          "by": "person:directory:pasi-tuomi"
        }
      ],
      "attempts": [
        {
          "action": "patch.install",
          "by": "person:directory:pasi-tuomi",
          "performed": true
        },
        {
          "action": "config.change",
          "by": "person:directory:pasi-tuomi",
          "performed": true
        }
      ],
      "outcome": {
        "result": "recovered",
        "lasting": "unknown",
