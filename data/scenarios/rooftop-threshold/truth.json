      "key": "A",
      "title": "ROOF-14 high temperature alarm from lowered threshold in 5.1.0 config bundle",
      "sourceIds": [
        "teams:1",
        "teams:2",
        "teams:3",
        "teams:4",
        "teams:7",
        "teams:8",
        "slack:1784711400.000100"
      ],
      "realCause": "The 5.1.0 config bundle lowered the temperature alarm threshold from 55 to 40 degrees; the cabinet was within spec.",
      "expectedClaims": [
        {
          "type": "observation",
          "statement": "ROOF-14 raises a high temperature alarm while the cabinet reads 41 degrees and it is 29 outside",
          "by": "person:directory:kalevi-heino"
        },
        {
          "type": "condition",
          "statement": "ROOF-14 runs firmware 5.1.0 upgraded the previous Tuesday",
          "by": "person:directory:kalevi-heino"
        },
        {
          "type": "hypothesis",
          "statement": "The 5.1.0 config bundle lowered the temperature alarm threshold to 40 degrees",
          "by": "person:directory:antero-lahtinen"
        },
        {
          "type": "advice",
          "statement": "Raise the alarm threshold back to 55 remotely and no roof visit is needed",
          "by": "person:directory:antero-lahtinen"
        },
        {
          "type": "action",
          "statement": "Antero set the ROOF-14 temperature threshold back to 55",
          "by": "person:directory:antero-lahtinen"
        },
        {
          "type": "outcome",
          "statement": "The ROOF-14 alarm cleared after the threshold was restored",
          "by": "person:directory:kalevi-heino"
        },
        {
          "type": "outcome",
          "statement": "No alarm overnight and a peak of 43 degrees below the restored threshold",
          "by": "person:directory:kalevi-heino"
        }
      ],
