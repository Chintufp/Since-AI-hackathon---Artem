  "incidents": [
    {
      "key": "A",
      "title": "AGG-014 BGP flaps after firmware 9.4.2 with changed hold timers",
      "sourceIds": [
        "teams:1",
        "teams:2",
        "teams:3",
        "teams:4",
        "teams:5",
        "teams:6",
        "teams:7",
        "teams:8",
        "teams:9",
        "teams:10",
        "email:<f03-agg014-stable@kalevanet.example>"
      ],
      "realCause": "The upgrade bundle changed hold timers from 90 to 30 seconds; peers behind the long-haul link need 90.",
      "expectedClaims": [
        {
          "type": "observation",
          "statement": "Two BGP peers on AGG-014 flap, up about five minutes then down, after the firmware upgrade",
          "by": "person:directory:hanna-kallio"
        },
        {
          "type": "condition",
          "statement": "AGG-014 upgraded from firmware 9.3.7 to 9.4.2",
          "by": "person:directory:hanna-kallio"
        },
        {
          "type": "condition",
          "statement": "The upgrade bundle carried new hold timers of 30 seconds instead of 90",
          "by": "person:directory:hanna-kallio"
        },
        {
          "type": "advice",
          "statement": "Roll back the hold timer part of the config and keep the new firmware",
          "by": "person:directory:lauri-ahonen"
        },
        {
          "type": "action",
          "statement": "Toivo rolled back the hold timers on AGG-014",
          "by": "person:directory:toivo-aaltonen"
        },
        {
          "type": "outcome",
          "statement": "Both BGP sessions are up with no flaps after the hold timer rollback",
          "by": "person:directory:hanna-kallio"
        },
        {
          "type": "outcome",
          "statement": "No flaps for three days after the rollback so the ticket can be closed",
          "by": "person:directory:hanna-kallio"
        }
      ],
      "attempts": [
        {
          "action": "config.rollback",
          "by": "person:directory:toivo-aaltonen",
          "performed": true
        },
        {
          "action": "firmware.downgrade",
          "by": "person:directory:toivo-aaltonen",
          "performed": false
        }
      ],
      "outcome": {
        "result": "recovered",
        "lasting": "confirmed",
        "reportedBy": "person:directory:hanna-kallio"
      },
      "knowledge": {
