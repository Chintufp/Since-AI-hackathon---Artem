      "key": "A",
      "title": "ACC-12 voice VLAN lost after template v7, rolled back to v6",
      "sourceIds": [
        "teams:1",
        "teams:2",
        "teams:3",
        "teams:4",
        "teams:7",
        "teams:8",
        "email:<f05-change-note-acc12@kalevanet.example>"
      ],
      "realCause": "Template v7 contained a typo in the voice VLAN range.",
      "expectedClaims": [
        {
          "type": "observation",
          "statement": "Voice VLAN 210 dropped on ACC-12 about ten minutes after the template v7 push while the data VLAN stayed fine",
          "by": "person:directory:antti-korhonen"
        },
        {
          "type": "condition",
          "statement": "ACC-12 is an N3 model installed in 2019",
          "by": "person:directory:antti-korhonen"
        },
        {
          "type": "hypothesis",
          "statement": "Template v7 changed the voice VLAN range",
          "by": "person:directory:jarmo-heikkinen"
        },
        {
          "type": "advice",
          "statement": "Roll ACC-12 back to the v6 template",
          "by": "person:directory:jarmo-heikkinen"
        },
        {
          "type": "action",
          "statement": "Jarmo rolled ACC-12 back to v6 and saved it to the startup config",
          "by": "person:directory:jarmo-heikkinen"
        },
        {
          "type": "outcome",
          "statement": "VLAN 210 is back on all ports and phones on floor 3 registered again",
          "by": "person:directory:antti-korhonen"
        }
      ],
      "attempts": [
        {
          "action": "config.rollback",
          "by": "person:directory:jarmo-heikkinen",
          "performed": true
        }
      ],
      "outcome": {
        "result": "recovered",
        "lasting": "unknown",
        "reportedBy": "person:directory:antti-korhonen"
      },
