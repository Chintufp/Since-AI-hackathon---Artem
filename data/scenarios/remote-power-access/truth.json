      "sourceIds": [
        "teams:1",
        "teams:2",
        "teams:3",
        "teams:4",
        "teams:5",
        "teams:6",
        "teams:7",
        "teams:8"
      ],
      "realCause": "Loose DC distribution breaker terminal; the rectifier swap disturbed the terminals and restored contact only temporarily.",
      "expectedClaims": [
        {
          "type": "observation",
          "statement": "RBS-310 drops off and returns about every 40 minutes with DC low alarms",
          "by": "person:directory:marja-niemi"
        },
        {
          "type": "observation",
          "statement": "Rectifier module 2 at RBS-310 is warm with a loud fan and DC voltage swings between 46 and 53 volts",
          "by": "person:directory:ilmari-karjalainen"
