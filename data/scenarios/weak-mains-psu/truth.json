          "statement": "Tauno swapped the 48 V PSU at MW-77",
          "by": "person:directory:tauno-hiltunen"
        },
        {
          "type": "outcome",
          "statement": "PSU output is clean and the MW-77 link is stable with no alarms after the swap",
          "by": "person:directory:anneli-koivisto"
        }
