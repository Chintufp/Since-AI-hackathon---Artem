    {
      "key": "B",
      "title": "ACC-30 voice VLAN lost after v7; rollback to v6 fails on the N5 model",
      "sourceIds": [
        "slack:1783587600.000100",
        "slack:1783587900.000200",
        "slack:1783588320.000300",
        "slack:1783590000.000400"
      ],
      "realCause": "v7 voice range typo. v6 has no profile for the N5 port layout, so the rollback took the uplinks down; the v7.1 patch fixed it.",
      "expectedClaims": [
        {
          "type": "observation",
          "statement": "ACC-30 lost voice VLAN 210 after template v7, an N5 model",
          "by": "person:directory:antti-korhonen"
        },
        {
          "type": "action",
          "statement": "Jarmo rolled ACC-30 back to v6 which took the uplink ports down",
          "by": "person:directory:jarmo-heikkinen"
        },
        {
          "type": "condition",
          "statement": "The v6 template has no profile for the N5 port layout",
          "by": "person:directory:jarmo-heikkinen"
        },
        {
          "type": "advice",
          "statement": "Do not roll back N5 units, apply the v7.1 patch that fixes the voice range typo",
          "by": "person:directory:sirkka-lindholm"
        },
        {
          "type": "action",
          "statement": "Jarmo applied the v7.1 patch on ACC-30",
          "by": "person:directory:jarmo-heikkinen"
        },
        {
          "type": "outcome",
          "statement": "Uplinks and VLAN 210 are back on ACC-30 after the v7.1 patch",
          "by": "person:directory:jarmo-heikkinen"
        }
      ],
      "attempts": [
        {
          "action": "config.rollback",
          "by": "person:directory:jarmo-heikkinen",
          "performed": true
        },
        {
          "action": "config.patch",
          "by": "person:directory:jarmo-heikkinen",
          "performed": true
        }
      ],
      "outcome": {
        "result": "recovered",
        "lasting": "unknown",
        "reportedBy": "person:directory:jarmo-heikkinen"
      },
