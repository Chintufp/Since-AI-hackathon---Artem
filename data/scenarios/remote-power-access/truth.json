        {
          "type": "condition",
          "statement": "RBS-310 cabinet was installed in 2016",
          "by": "person:directory:marja-niemi"
        },
        {
          "type": "hypothesis",
          "statement": "Rectifier module 2 is failing",
          "by": "person:directory:risto-peltola"
        },
        {
          "type": "advice",
          "statement": "Swap rectifier module 2 using the spare from the depot box",
          "by": "person:directory:risto-peltola"
        },
        {
          "type": "action",
          "statement": "Ilmari swapped rectifier module 2 at RBS-310",
          "by": "person:directory:ilmari-karjalainen"
        },
        {
          "type": "outcome",
          "statement": "Voltage steady at 53.4 volts and no resets for 25 minutes after the swap",
          "by": "person:directory:ilmari-karjalainen"
        },
        {
          "type": "outcome",
          "statement": "NOC confirms RBS-310 stable since 15:38",
          "by": "person:directory:marja-niemi"
        }
